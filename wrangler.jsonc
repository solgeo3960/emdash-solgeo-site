{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "emdash-solgeo-site",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "emdash-solgeo-site","database_id": "4ce7e8d2-1905-4ebf-a459-ace4976cda3f",
		},
	],
	// Astro session storage, pinned to the namespace `wrangler deploy` auto-provisioned.
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "2f8463320842497da10ab847737cdb4d",
		},
	],
	// `wrangler preview` (PR builds) only uses bindings listed here; production
	// D1/R2 are deliberately not shared with previews.
	"previews": {
		"kv_namespaces": [
			{
				"binding": "SESSION",
				"id": "2f8463320842497da10ab847737cdb4d",
			},
		],
	},
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "emdash-solgeo-media","preview_bucket_name": "emdash-solgeo-media",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
